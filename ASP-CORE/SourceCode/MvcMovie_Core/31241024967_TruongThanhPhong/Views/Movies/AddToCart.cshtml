@model CartViewModel
@{ViewData["Title"]="Giỏ hàng";}
<p class="eyebrow">01 GIỎ HÀNG → 02 THÔNG TIN → 03 HOÀN TẤT</p>
<h1>Giỏ hàng của bạn</h1>
<p class="muted">Kiểm tra phim và số lượng trước khi đặt hàng.</p>
@if(Model.Count==0){<div class="empty-state">
<h2>Giỏ hàng đang trống</h2>
<p>Chọn một bộ phim để bắt đầu hành trình mới.</p>
<a class="btn btn-primary" asp-action="Index">Khám phá phim →</a>
</div>}
else{<div class="cart-layout">
<div class="panel table-responsive">
<table class="table align-middle" id="cartTable">
<thead>
<tr>
<th>Phim</th>
<th>Đơn giá</th>
<th>Số lượng</th>
<th>Thành tiền</th>
<th>
</th>
</tr>
</thead>
<tbody>@foreach(var line in Model.Lines){<tr>
<td>
<img class="mini-poster" src="@line.Movie.PicturePath" alt=""/>
<strong>@line.Movie.Title</strong>
</td>
<td>@line.Movie.Price.ToString("N0") ₫</td>
<td>
<form asp-action="UpdateCart" method="post" class="quantity-form">
<input type="hidden" name="id" value="@line.Movie.ID"/>
<input name="quantity" type="number" min="1" max="99" value="@line.Quantity" aria-label="Số lượng @line.Movie.Title" class="form-control"/>
<button class="btn btn-outline-secondary btn-sm">Cập nhật</button>
</form>
</td>
<td class="line-total">@line.Total.ToString("N0") ₫</td>
<td>
<form asp-action="RemoveFromCart" method="post">
<input type="hidden" name="maMovies" value="@line.Movie.ID"/>
<button class="text-button danger" aria-label="Xóa @line.Movie.Title khỏi giỏ">Xóa</button>
</form>
</td>
</tr>}</tbody>
</table>
</div>
<aside class="panel order-summary">
<h2>Tóm tắt giỏ hàng</h2>
<p>@Model.Count sản phẩm</p>
<div class="total-row">
<span>Tổng cộng</span>
<strong id="cart-total">@Model.Total.ToString("N0") ₫</strong>
</div>
<p class="muted">Giá được kiểm tra lại trên máy chủ khi đặt hàng.</p>
<a class="btn btn-primary w-100" asp-action="Checkout">Tiếp tục đặt hàng →</a>
<a class="back-link" asp-action="Index">← Tiếp tục mua phim</a>
</aside>
</div>}
