<!DOCTYPE html>
<html lang="vi">
<head>
<meta charset="utf-8"/>
<meta name="viewport" content="width=device-width, initial-scale=1"/>
<title>@ViewData["Title"] · Phong Cinema</title>
<link rel="stylesheet" href="~/lib/bootstrap/dist/css/bootstrap.min.css"/>
<link rel="stylesheet" href="~/css/site.css" asp-append-version="true"/>
</head>
<body>
<header class="site-header">
<div class="shell nav-wrap">
<a class="brand" asp-controller="Movies" asp-action="Index">
<span class="brand-icon">P</span>
<span>PHONG <b>CINEMA</b>
<small>CÂU CHUYỆN HAY CHO MỖI NGÀY</small>
</span>
</a>
<nav aria-label="Điều hướng chính">
<a asp-controller="Movies" asp-action="Index">Khám phá phim</a>@if(User.IsInRole("Admin")){<a asp-controller="Movies" asp-action="Manage">Quản lý phim</a>
<a asp-controller="Genres" asp-action="Index">Thể loại</a>
<a asp-controller="Orders" asp-action="Index">Đơn hàng</a>}</nav>
<div class="account">
<partial name="_LoginPartial"/>
</div>
</div>
<div class="cart-bar">
<div class="shell">@await Component.InvokeAsync("CartSummary")</div>
</div>
</header>
<main class="shell main-content" id="main">@if(TempData["Success"] is string success){<div class="alert alert-success" role="status">@success</div>}@if(TempData["Error"] is string error){<div class="alert alert-danger" role="alert">@error</div>}@RenderBody()</main>
<footer>
<div class="shell footer-wrap">
<div>
<strong>PHONG CINEMA</strong>
<p>Cửa hàng phim mô phỏng trong bài thực hành ASP.NET Core MVC.</p>
<small>Không thu tiền thật. Nội dung phim và ảnh bìa được tạo cho bài học.</small>
</div>
<div>Trương Thanh Phong · 31241024967<br/>Lớp 26C1INF50902702<br/>© @DateTime.Now.Year</div>
</div>
</footer>
<script src="~/lib/jquery/dist/jquery.min.js">
</script>
<script src="~/lib/bootstrap/dist/js/bootstrap.bundle.min.js">
</script>
<script src="~/js/site.js" asp-append-version="true">
</script>@await RenderSectionAsync("Scripts",required:false)</body>
</html>
